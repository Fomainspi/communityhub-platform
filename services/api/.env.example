# PostgreSQL connection string
DATABASE_URL="postgresql://communityhub:change-me@localhost:5432/communityhub?schema=public"

# API listener
PORT=4000
NODE_ENV=development

# Amazon Cognito User Pool (configure these values before using authenticated routes)
AWS_REGION="ap-southeast-1"
COGNITO_USER_POOL_ID="ap-southeast-1_REPLACE_ME"
COGNITO_CLIENT_ID="REPLACE_WITH_USER_POOL_APP_CLIENT_ID"
COGNITO_DOMAIN="https://REPLACE_WITH_COGNITO_DOMAIN.auth.ap-southeast-1.amazoncognito.com"

# Optional, explicit organization seed settings (not hard-coded into the application)
COMMUNITYHUB_SEED_ORG_SLUG="acpinc"
COMMUNITYHUB_SEED_ORG_NAME="Association of Cameroonians in the Philippines"
# Optional: user must have signed in once before this email can be assigned as a community admin.
# COMMUNITYHUB_BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
