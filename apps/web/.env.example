# Cognito managed-login settings. Register these exact callback and logout URLs in the app client.
COGNITO_DOMAIN="https://REPLACE_WITH_COGNITO_DOMAIN.auth.ap-southeast-1.amazoncognito.com"
COGNITO_CLIENT_ID="REPLACE_WITH_USER_POOL_APP_CLIENT_ID"
COGNITO_REDIRECT_URI="http://localhost:3000/api/auth/callback"
COGNITO_LOGOUT_URI="http://localhost:3000/login"

# API origin reachable by the Next.js server
COMMUNITYHUB_API_URL="http://localhost:4000"
